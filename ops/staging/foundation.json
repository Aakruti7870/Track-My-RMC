{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Isolated TrackMyRMC staging foundation. No production resources, records, identities or secrets are referenced.",
  "Parameters": {
    "ImageId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64",
      "Description": "Amazon Linux 2023 x86_64 image"
    },
    "ComputeSize": {
      "Type": "String",
      "Default": "t3.small",
      "AllowedValues": [
        "t3.small",
        "t3.medium"
      ],
      "Description": "Stateless staging application host size"
    }
  },
  "Rules": {
    "MumbaiOnly": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Equals": [
              {
                "Ref": "AWS::Region"
              },
              "ap-south-1"
            ]
          },
          "AssertDescription": "Deploy only in the authorized Mumbai region."
        }
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": "10.88.0.0/16",
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "TrackMyRMC"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "Gateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Project",
            "Value": "TrackMyRMC"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "GatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "InternetGatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "AppSubnet": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.88.1.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "TrackMyRMC"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "DbSubnet0": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.88.10.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Project",
            "Value": "TrackMyRMC"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "DbSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "CidrBlock": "10.88.11.0/24",
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Project",
            "Value": "TrackMyRMC"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "PublicRoutes": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "TrackMyRMC"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "PublicRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "GatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRoutes"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "Gateway"
        }
      }
    },
    "PublicRouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": {
          "Ref": "AppSubnet"
        },
        "RouteTableId": {
          "Ref": "PublicRoutes"
        }
      }
    },
    "AppSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Staging host with no inbound access; use authenticated SSM sessions",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0",
            "Description": "AWS APIs, SSM and HTTPS package repositories"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0",
            "Description": "OS package repositories"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "CidrIp": "10.88.0.0/16",
            "Description": "Isolated staging PostgreSQL"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "TrackMyRMC"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "DatabaseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "PostgreSQL from the new staging host only",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "SourceSecurityGroupId": {
              "Ref": "AppSecurityGroup"
            },
            "Description": "PostgreSQL from the isolated staging host only"
          }
        ],
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "10.88.0.0/16",
            "Description": "No internet route exists on database subnets"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "TrackMyRMC"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "DatabaseSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Private subnets in the isolated staging VPC",
        "SubnetIds": [
          {
            "Ref": "DbSubnet0"
          },
          {
            "Ref": "DbSubnet1"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "TrackMyRMC"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "DBInstanceIdentifier": {
          "Fn::Sub": "${AWS::StackName}-postgres"
        },
        "DBName": "trackmyrmc_staging",
        "Engine": "postgres",
        "EngineVersion": "18.3",
        "DBInstanceClass": "db.t4g.micro",
        "AllocatedStorage": "20",
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "MasterUsername": "staging_owner",
        "ManageMasterUserPassword": true,
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnets"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DatabaseSecurityGroup"
          }
        ],
        "PubliclyAccessible": false,
        "MultiAZ": false,
        "BackupRetentionPeriod": 7,
        "DeletionProtection": true,
        "AutoMinorVersionUpgrade": true,
        "CopyTagsToSnapshot": true,
        "Tags": [
          {
            "Key": "Project",
            "Value": "TrackMyRMC"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "AppSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}/jwt_secret"
        },
        "Description": "Generated staging-only secret; values must never enter agent output",
        "GenerateSecretString": {
          "SecretStringTemplate": "{}",
          "GenerateStringKey": "JWT_SECRET",
          "PasswordLength": 64,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "TrackMyRMC"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "OtpSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}/otp_pepper"
        },
        "Description": "Generated staging-only secret; values must never enter agent output",
        "GenerateSecretString": {
          "SecretStringTemplate": "{}",
          "GenerateStringKey": "OTP_PEPPER",
          "PasswordLength": 64,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "TrackMyRMC"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "Artifacts": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "IgnorePublicAcls": true,
          "BlockPublicPolicy": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "TrackMyRMC"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "ArtifactTransportPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "Artifacts"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "Artifacts",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${Artifacts.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": false
                }
              }
            }
          ]
        }
      }
    },
    "InstanceRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          {
            "Fn::Sub": "arn:${AWS::Partition}:iam::aws:policy/AmazonSSMManagedInstanceCore"
          },
          {
            "Ref": "RuntimePolicy"
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "TrackMyRMC"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "InstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "InstanceRole"
          }
        ]
      }
    },
    "AppHost": {
      "Type": "AWS::EC2::Instance",
      "DependsOn": "PublicRoute",
      "Properties": {
        "ImageId": {
          "Ref": "ImageId"
        },
        "InstanceType": {
          "Ref": "ComputeSize"
        },
        "SubnetId": {
          "Ref": "AppSubnet"
        },
        "SecurityGroupIds": [
          {
            "Ref": "AppSecurityGroup"
          }
        ],
        "IamInstanceProfile": {
          "Ref": "InstanceProfile"
        },
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled",
          "HttpPutResponseHopLimit": 1
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeType": "gp3",
              "VolumeSize": 30,
              "Encrypted": true,
              "DeleteOnTermination": true
            }
          }
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "TrackMyRMC"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          },
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "${AWS::StackName}-app"
            }
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nset -euo pipefail\nsystemctl enable --now amazon-ssm-agent\ninstall -d -m 0750 /opt/trackmyrmc-staging\nprintf '%s\\n' 'Foundation only: no production data or accounts loaded' > /opt/trackmyrmc-staging/STATUS\n"
        },
        "CreditSpecification": {
          "CPUCredits": "standard"
        },
        "EbsOptimized": true
      }
    },
    "ApplicationDatabaseSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}/application-database"
        },
        "Description": "Separate staging application role credential; role creation and grants required before use",
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\":\"trackmyrmc_app\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 64,
          "ExcludePunctuation": true
        },
        "Tags": [
          {
            "Key": "Project",
            "Value": "TrackMyRMC"
          },
          {
            "Key": "Environment",
            "Value": "staging"
          },
          {
            "Key": "ManagedBy",
            "Value": "CloudFormation"
          }
        ]
      }
    },
    "RuntimePolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "Description": "Read only staging runtime secrets and staging release artifacts",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": [
                "secretsmanager:GetSecretValue"
              ],
              "Resource": [
                {
                  "Ref": "AppSecret"
                },
                {
                  "Ref": "OtpSecret"
                },
                {
                  "Ref": "ApplicationDatabaseSecret"
                }
              ]
            },
            {
              "Effect": "Allow",
              "Action": [
                "s3:GetObject"
              ],
              "Resource": {
                "Fn::Sub": "${Artifacts.Arn}/releases/*"
              }
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "VpcId": {
      "Description": "Isolated staging VPC",
      "Value": {
        "Ref": "Vpc"
      }
    },
    "InstanceId": {
      "Description": "SSM-only staging host; no inbound ports",
      "Value": {
        "Ref": "AppHost"
      }
    },
    "DatabaseEndpoint": {
      "Description": "Private staging database endpoint",
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Address"
        ]
      }
    },
    "DatabaseSecretArn": {
      "Description": "Staging database credential reference; no value",
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "MasterUserSecret.SecretArn"
        ]
      }
    },
    "AppSecretArn": {
      "Description": "Staging JWT reference; no value",
      "Value": {
        "Ref": "AppSecret"
      }
    },
    "OtpSecretArn": {
      "Description": "Staging OTP pepper reference; no value",
      "Value": {
        "Ref": "OtpSecret"
      }
    },
    "ArtifactBucket": {
      "Description": "Private staging release bucket",
      "Value": {
        "Ref": "Artifacts"
      }
    },
    "ApplicationDatabaseSecretArn": {
      "Description": "Least privilege app DB credential reference; no value",
      "Value": {
        "Ref": "ApplicationDatabaseSecret"
      }
    }
  }
}
