{
  "expo": {
    "name": "TrackMyRMC",
    "slug": "trackmyrmc",
    "version": "2.0.30",
    "orientation": "portrait",
    "scheme": "trackmyrmc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.trackmyrmc.concreteking"
    },
    "android": {
      "package": "com.trackmyrmc.concreteking",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "INTERNET"
      ],
      "versionCode": 88
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow TrackMyRMC to use your location to track concrete mixer dispatches in real time."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
