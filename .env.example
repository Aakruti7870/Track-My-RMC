# TrackMyRMC LOCAL development example (not a production secret bundle).

# --- Database Configuration ---
DATABASE_URL=postgres://trackmyrmc_user:securepassword@localhost:5432/trackmyrmc
# Pool settings are currently configured in backend/src/db/pool.rs;
# unsupported DATABASE_MAX_CONNECTIONS / DATABASE_MIN_CONNECTIONS variables are omitted.

# --- Server Configuration ---
PORT=8000
HOST=127.0.0.1
APP_ENV=development
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:19006
RUST_LOG=info

# --- Security & JWT ---
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS_BEFORE_STARTUP_0123456789
JWT_EXPIRATION_HOURS=72

# --- Meta WhatsApp Cloud API (Customer & Driver OTP - Server-Side Only) ---
META_WHATSAPP_TOKEN=your_meta_system_user_token
META_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WABA_ID=your_meta_whatsapp_business_account_id
META_GRAPH_API_VERSION=v26.0

# --- Transactional Email (Staff, Owner & Admin OTP - Server-Side Only) ---
EMAIL_API_KEY=re_your_resend_api_key
EMAIL_FROM_ADDRESS=noreply@trackmyrmc.com

# --- OTP Security & Rate Limiting ---
OTP_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS_BEFORE_STARTUP
OTP_EXPIRATION_MINUTES=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3

# Generate a dedicated 32-byte key with openssl rand -hex 32.
TOTP_ENCRYPTION_ACTIVE_KEY_ID=local
TOTP_ENCRYPTION_KEYS=local=REPLACE_WITH_GENERATED_64_HEX_CHARACTERS

# --- Frontend Client Configuration ---
EXPO_PUBLIC_BACKEND_URL=https://trackmyrmc.com
EXPO_PUBLIC_API_URL=https://trackmyrmc.com
VITE_API_URL=https://trackmyrmc.com

# Reviewer access is off by default; enable only with approved reviewer policy.
NATIVE_AUTOMATION_WORKER_ENABLED=false
NATIVE_SUPPORT_AUTOMATION_ENABLED=false
TRACKMYRMC_PROVISIONAL_TTL_HOURS=168
TRACKMYRMC_PROVISIONAL_REMINDERS_ENABLED=false
TRACKMYRMC_PROVISIONAL_REMINDER_HOURS=24
PRIVILEGED_RECOVERY_ENABLED=false
EXPO_PUBLIC_ENABLE_PLAY_REVIEW=false
