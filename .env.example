# TrackMyRMC Production Environment Configuration

# --- Database Configuration ---
DATABASE_URL=postgres://trackmyrmc_user:securepassword@localhost:5432/trackmyrmc
DATABASE_MAX_CONNECTIONS=20
DATABASE_MIN_CONNECTIONS=5

# --- Server Configuration ---
PORT=8000
HOST=0.0.0.0
APP_ENV=production
CORS_ORIGIN=*
RUST_LOG=info,trackmyrmc_backend=debug

# --- Security & JWT ---
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRATION_HOURS=72

# --- Meta WhatsApp Cloud API (Customer & Driver OTP - Server-Side Only) ---
META_WHATSAPP_TOKEN=your_meta_system_user_token
META_PHONE_NUMBER_ID=your_meta_phone_number_id
META_WABA_ID=your_meta_whatsapp_business_account_id

# --- Transactional Email (Staff, Owner & Admin OTP - Server-Side Only) ---
EMAIL_API_KEY=your_postmark_or_sendgrid_api_key
EMAIL_FROM_ADDRESS=noreply@trackmyrmc.com

# --- OTP Security & Rate Limiting ---
OTP_EXPIRATION_MINUTES=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3

# --- WebAuthn / FIDO2 Passkeys ---
WEBAUTHN_RP_ID=trackmyrmc.com
WEBAUTHN_RP_ORIGIN=https://trackmyrmc.com

# --- Frontend Client Configuration ---
EXPO_PUBLIC_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
