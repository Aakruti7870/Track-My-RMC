# LOCAL / ISOLATED DEVELOPMENT TEMPLATE ONLY. Never use these values in production.
# Create a separate local PostgreSQL database before starting the backend.
DATABASE_URL=postgres://trackmyrmc_user:securepassword@localhost:5432/trackmyrmc
APP_ENV=development
PORT=8000
HOST=127.0.0.1
# Browser origins must be explicit; production requires HTTPS origins.
CORS_ORIGIN=http://localhost:8081,http://localhost:19006
RUST_LOG=info,trackmyrmc_backend=debug

# Replace these development-only samples with unique random values.
JWT_SECRET=local-development-jwt-key-change-before-production-xxxxxxxxxxxxxxxxxxxxxxxx
JWT_EXPIRATION_HOURS=24
OTP_PEPPER=local-development-otp-pepper-change-before-production-xxxxxxxxxxxx
OTP_EXPIRATION_MINUTES=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3

# Provider credentials: set only for explicitly approved sandbox/local tests.
# META_WHATSAPP_TOKEN=
# META_PHONE_NUMBER_ID=
# META_WABA_ID=
META_GRAPH_API_VERSION=v26.0
# EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@trackmyrmc.com
# GOOGLE_PLACES_API_KEY=

# Google Play reviewer access is disabled unless intentionally configured.
PLAY_SIGNING_SHA256=
PLAY_REVIEW_ACCESS_CODE=

# New internal automation stays OFF without independent approval.
NATIVE_AUTOMATION_WORKER_ENABLED=false
NATIVE_SUPPORT_AUTOMATION_ENABLED=false
PRIVILEGED_RECOVERY_ENABLED=false
