# PostgreSQL Connection
DATABASE_URL=postgres://trackmyrmc_user:securepassword@localhost:5432/trackmyrmc

# Server Configuration
PORT=8000
HOST=0.0.0.0
APP_ENV=development
# Comma-separated browser origins. Use exact HTTPS origins in production.
CORS_ORIGIN=http://localhost:8081,http://localhost:19006,http://localhost:5173
RUST_LOG=info,trackmyrmc_backend=debug

# Security & Authentication
JWT_SECRET=replace_with_a_unique_random_secret_at_least_64_bytes_long
JWT_EXPIRATION_HOURS=24

# Meta WhatsApp Cloud API (Server-Side Only - Customer & Driver OTP)
# https://developers.facebook.com/docs/whatsapp/cloud-api
META_WHATSAPP_TOKEN=replace_with_meta_cloud_api_token
META_PHONE_NUMBER_ID=100000000000000
META_WABA_ID=200000000000000

# Transactional Email Provider (Server-Side Only - Staff, Owner & Admin OTP)
EMAIL_API_KEY=postmark_or_sendgrid_token
EMAIL_FROM_ADDRESS=noreply@trackmyrmc.com

# OTP Security Parameters
# Use a unique random value of at least 32 bytes in production.
OTP_PEPPER=replace_with_a_unique_random_pepper_at_least_32_bytes
OTP_EXPIRATION_MINUTES=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3
